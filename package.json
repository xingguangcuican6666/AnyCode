{
  "name": "meowcode",
  "version": "0.1.3",
  "description": "MeowCode — a Claude Code–style agentic coding CLI (framework skeleton).",
  "type": "module",
  "bin": {
    "meowcode": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsup",
    "build:bin": "bun run scripts/build-binaries.mjs",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "version:check": "node scripts/sync-version.mjs check",
    "version:write": "node scripts/sync-version.mjs write",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "keywords": [
    "cli",
    "ai",
    "agent",
    "ink",
    "coding-assistant"
  ],
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingguangcuican6666/MeowCode.git"
  },
  "bugs": {
    "url": "https://github.com/xingguangcuican6666/MeowCode/issues"
  },
  "homepage": "https://github.com/xingguangcuican6666/MeowCode#readme",
  "dependencies": {
    "ink": "~5.1.0",
    "marked": "^12.0.2",
    "marked-terminal": "^7.1.0",
    "react": "~18.3.1",
    "string-width": "^7.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true
  }
}
